# Copy to .env and fill in ONE of the two keys below.
# If OPENAI_API_KEY is set, OpenAI is used; otherwise Claude.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: which OpenAI model to use (default gpt-5)
# OPENAI_MODEL=gpt-5

# Port for the local web UI
PORT=3030

# Who you are and what you offer. The agent uses this to write "how I can help".
SENDER_NAME=Your Name
SENDER_COMPANY=TALYNT LABS
SENDER_PITCH=We help companies hire faster with talent intelligence: we source, evaluate and shortlist pre-vetted candidates so hiring managers only meet people worth meeting. Typical time-to-shortlist is days, not weeks.

# Optional: a link or call to action to end messages with
SENDER_CTA=Open to a 15-min call this week?

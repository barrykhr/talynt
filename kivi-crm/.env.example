# KiviTronics CRM — environment configuration
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in the hosting provider's encrypted environment settings.

# Public URL the app is served from (no trailing slash). Used for OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe to expose: row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security. Used for Google token storage,
# background sync and the provisioning script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Gmail & Google Calendar connections (optional until configured).
# OAuth client from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 32 random bytes, base64-encoded. Encrypts Google tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it disconnects every Google connection (users simply reconnect).
TOKEN_ENCRYPTION_KEY=

# Shared secret for the scheduled sync endpoint (/api/cron/sync).
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Development only — never set in production.
# ---------------------------------------------------------------------------
# ALLOW_DEV_SEED=true

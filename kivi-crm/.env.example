# KiviTronics CRM — environment configuration
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in the hosting provider's encrypted environment settings.

# Public URL the app is served from (no trailing slash). Used for OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe to expose: row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security. Used for Google token storage,
# background sync and the provisioning script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Gmail & Google Calendar connections (optional until configured).
# OAuth client from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 32 random bytes, base64-encoded. Encrypts Google tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it disconnects every Google connection (users simply reconnect).
TOKEN_ENCRYPTION_KEY=

# Shared secret for the scheduled sync endpoint (/api/cron/sync).
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Company research & outreach drafts (optional; see docs/RESEARCH.md).
# The first configured provider is used: Claude, then OpenAI, then the
# standalone outreach agent. Set RESEARCH_PROVIDER to force one ("none" disables).
# ---------------------------------------------------------------------------
# RESEARCH_PROVIDER=claude
ANTHROPIC_API_KEY=
# RESEARCH_CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# Existing standalone outreach agent (outreach-agent/server.js), if you prefer it.
# Must be reachable from the CRM server (it binds to 127.0.0.1 by default).
OUTREACH_AGENT_URL=
OUTREACH_AGENT_PASSWORD=
# Used in drafts (ported from the agent's SENDER_* settings). The sender name is the signed-in user.
SENDER_COMPANY=KiviTronics Consulting
SENDER_PITCH=
SENDER_CTA=Open to a 15-minute call this week?

# ---------------------------------------------------------------------------
# Website lead capture endpoint (optional; see docs/LEAD_CAPTURE.md).
# ---------------------------------------------------------------------------
LEAD_CAPTURE_ENABLED=false
# Comma-separated origins allowed to post from a browser.
LEAD_CAPTURE_ALLOWED_ORIGINS=https://kivitronicsconsulting.com,https://www.kivitronicsconsulting.com
# Random string; IP addresses are stored only as salted hashes for rate limiting.
CAPTURE_IP_SALT=
# Optional Cloudflare Turnstile secret for an extra bot check.
TURNSTILE_SECRET_KEY=

# Time zone for "today", due dates and date inputs.
# NEXT_PUBLIC_APP_TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Development only — never set in production.
# ---------------------------------------------------------------------------
# ALLOW_DEV_SEED=true
